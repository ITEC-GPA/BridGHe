                    <item name="Description" type_name="gh_string" type_code="10">NOTA Q — script di riferimento aziendale</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">7241af69-f02a-4faa-b62a-23370f3f2ed1</item>
                    <item name="Name" type_name="gh_string" type_code="10">NOTA Q — script di riferimento aziendale</item>
