                <item name="Name" type_name="gh_string" type_code="10">Bridge Displacement Envelope</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Envelope stored results with governing case/step and all six concomitant values. Global node translations Ux,Uy,Uz and rotations Rx,Ry,Rz. Compare translations with project serviceability limits separately. Uses model units, no unit conversion or interpolation. Absolute mode retains the governing sign.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">bcd91e40-51ff-4bb8-8c27-b00cb7cc7d4a</item>
                    <item name="Name" type_name="gh_string" type_code="10">Bridge Displacement Envelope</item>
