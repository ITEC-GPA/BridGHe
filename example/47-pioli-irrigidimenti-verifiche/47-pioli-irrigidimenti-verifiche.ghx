                <item name="Lib" type_name="gh_guid" type_code="9">db9c536d-770b-4586-8c8c-1c7a4df232b4</item>
                <item name="Name" type_name="gh_string" type_code="10">Bridge Section Increment</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
