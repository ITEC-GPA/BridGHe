                <chunk name="Container">
                  <items count="8">
                    <item name="Description" type_name="gh_string" type_code="10">NOTA FASE 20 — script di riferimento aziendale</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">b688c8cc-b965-4330-89ea-9f5b698bae92</item>
                    <item name="Name" type_name="gh_string" type_code="10">NOTA FASE 20 — script di riferimento aziendale</item>
                    <item name="NickName" type_name="gh_string" type_code="10">NOTA FASE 20 — script di riferimento aziendale</item>
