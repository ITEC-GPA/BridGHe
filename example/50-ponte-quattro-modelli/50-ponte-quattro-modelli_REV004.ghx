                    <item name="Description" type_name="gh_string" type_code="10">Report | ipotesi e campo delle verifiche</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">aedfc131-213c-4b7a-8b02-0b4ba0fead8d</item>
