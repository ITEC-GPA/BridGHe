              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="5">
                    <item name="Description" type_name="gh_string" type_code="10">Create a steel I section for every girder fabrication segment. An external panel holds editable dimensions; '*' inherits the base section. Press Tabella conci to populate/refresh it.</item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">d3f763f6-06d6-4a2d-bd5e-909bb7753e28</item>
