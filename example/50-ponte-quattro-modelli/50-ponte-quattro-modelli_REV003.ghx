                    </chunk>
                    <chunk name="param_input" index="1">
                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">Steel I Section + Beam property. Material and formulation are retained; dimensions marked '*' follow this section.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">31ead643-9496-4d8d-9fcc-364d3373d805</item>
                        <item name="Name" type_name="gh_string" type_code="10">Base Property</item>
