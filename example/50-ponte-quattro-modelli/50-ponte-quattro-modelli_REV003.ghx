                <item name="Lib" type_name="gh_guid" type_code="9">db9c536d-770b-4586-8c8c-1c7a4df232b4</item>
                <item name="Name" type_name="gh_string" type_code="10">Bridge State Override</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Assign uncracked or steel+rebar properties per FEM beam, retaining one physical section per fabrication segment. Stores the local state for the bridge checker. Shrinkage is excluded.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">e1188bc7-29a0-487b-a33c-9bd47056b40f</item>
