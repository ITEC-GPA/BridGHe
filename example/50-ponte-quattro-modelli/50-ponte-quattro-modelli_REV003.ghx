                        </item>
                      </items>
                    </chunk>
                    <chunk name="param_input" index="0">
                      <items count="8">
                        <item name="Description" type_name="gh_string" type_code="10">Physical segments from Bridge Fabrication Segments, before meshing. Existing Bridge Geometry is also accepted.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">8e60b314-bc5d-4dee-9a1b-dd9fd488ccce</item>
                        <item name="Name" type_name="gh_string" type_code="10">Fabrication Plan</item>
