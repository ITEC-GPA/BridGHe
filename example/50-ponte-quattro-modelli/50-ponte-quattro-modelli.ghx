              <chunks count="1">
                <chunk name="Container">
                  <items count="5">
                    <item name="Description" type_name="gh_string" type_code="10">Override longitudinal beam properties by fabrication segment ID. Keeps steel cross-members, IDs, loads and geometry; clears results in independent copies.</item>
