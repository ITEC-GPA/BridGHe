<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies></PropertyGroup>
  <Import Project="../../build/GpcReferences.props" />
  <ItemGroup>
    <ProjectReference Include="../../src/BridGHe.Common/BridGHe.Common.csproj" />
    <ProjectReference Include="../../src/BridGHe.Grasshopper/BridGHe.Grasshopper.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Rhino.Inside" Version="8.0.7-beta" />
    <PackageReference Include="RhinoCommon" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="$(RhinoVersion)" ExcludeAssets="runtime" />
    <!-- The shared plug-in check is tested from its reference copy. -->
    <Compile Include="../../src/BridGHe.Grasshopper/Helpers/PluginBuildCheck.cs" Link="PluginBuildCheck.cs" />
  </ItemGroup>
</Project>
