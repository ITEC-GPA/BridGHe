<Project>
  <ItemGroup>
    <Reference Include="GPCUtilities"><HintPath>$(BridGHeRoot)lib\GPC\GPCUtilities.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GPCGeometry"><HintPath>$(BridGHeRoot)lib\GPC\GPCGeometry.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="DelaunayMesh"><HintPath>$(BridGHeRoot)lib\GPC\DelaunayMesh.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GPCModel"><HintPath>$(BridGHeRoot)lib\GPC\GPCModel.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GPCChecker.Concrete"><HintPath>$(BridGHeRoot)lib\GPC\GPCChecker.Concrete.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GPCChecker.Steel"><HintPath>$(BridGHeRoot)lib\GPC\GPCChecker.Steel.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GPCChecker.CompositeBridge"><HintPath>$(BridGHeRoot)lib\GPC\GPCChecker.CompositeBridge.dll</HintPath><Private>true</Private></Reference>
    <None Include="$(BridGHeRoot)lib\GPC\release-set.json" Link="gpc-release-set.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckGpcLibraries" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <GpcValidationArguments Condition="'$(GpcAllowCandidate)' == 'true'">-AllowCandidate</GpcValidationArguments>
    </PropertyGroup>
    <Error Condition="!Exists('%(Reference.HintPath)') and '%(Reference.HintPath)' != ''" Text="Libreria mancante: %(Reference.HintPath). Ripristinare il set GPC fissato in lib/GPC." />
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(BridGHeRoot)tools\verify_gpc_set.ps1&quot; $(GpcValidationArguments)" />
  </Target>
</Project>
