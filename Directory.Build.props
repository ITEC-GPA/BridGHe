<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Company>gPC</Company>
    <Product>BridGHe</Product>
    <Deterministic>true</Deterministic>
    <RhinoVersion>8.27.26019.16021</RhinoVersion>
    <BridGHeRoot>$(MSBuildThisFileDirectory)</BridGHeRoot>
    <!-- Compiler outputs are private; only the plugin Release is published to bin. -->
    <BaseOutputPath>$(BridGHeRoot)obj\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(BridGHeRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <!-- Let MSBuild run the post-build event even when Visual Studio considers inputs up to date. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <!-- Ignore legacy generated sources before the cleanup target runs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\</RepositoryRoot>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
